  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build prod": "ng build --prod",
    "test": "ng test --sourceMap=false",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "test coverage": "ng test --code-coverage --sourceMap=false",
    "docs": "npm run typedoc -- --options typedoc.json --exclude '**/*.spec.ts' ./src/app/",
    "typedoc": "typedoc",
    "build:server:prod": "ng run sfc-webpage:server && webpack --config webpack.server.config.js --progress --colors",
    "build:browser:prod": "ng build --prod",
    "build:prod": "npm run build:server:prod && npm run build:browser:prod",
    "server": "node local.js"
  },
  "private": true,
